# Database Configuration
DATABASE_URL=postgresql+asyncpg://rtedd:rtedd@localhost:5432/rtedd
DB_USER=rtedd
DB_PASSWORD=rtedd
DB_NAME=rtedd
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# Server Configuration
MAX_REQUEST_SIZE_BYTES=1048576
MAX_BULK_INGEST_ROWS=5000

# Forecast Configuration
FORECAST_REFRESH_SECONDS=300
FORECAST_XGBOOST_N_JOBS=2
FORECAST_LIGHTGBM_RETRAIN_ROWS=168

# Weather Configuration
WEATHER_LATITUDE=43.6532
WEATHER_LONGITUDE=-79.3832

# API Client Configuration
API_BASE_URL=http://127.0.0.1:8000
CLIENT_RETRY_TOTAL=3
CLIENT_RETRY_BACKOFF_FACTOR=0.5
CLIENT_ROW_RETRY_TOTAL=10
CLIENT_REQUEST_TIMEOUT=30
CLIENT_SEND_MODE=bulk
CLIENT_BULK_CHUNK_SIZE=1000
CLIENT_REALTIME_DELAY_SECONDS=30

# Dashboard Configuration
SERVER_IP=127.0.0.1
